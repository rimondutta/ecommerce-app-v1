# =============================================================================
# Toy Hourse Ecommerce - Environment Variables Template
# Copy this file to .env.local for local development or set in Railway Dashboard
# =============================================================================

# Application & Authentication
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=your-32-character-secret-generate-with-openssl-rand-hex-32

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Cloudinary (Media Storage & Optimization)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://<key>:<secret>@<cloud-name>

# Caching & Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Email & Notifications (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="Toy Hourse <no-reply@your-domain.com>"
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASS=initial-admin-password

# Company Information
COMPANY_NAME="Toy Hourse"
COMPANY_ADDRESS="Dhaka, Bangladesh"
COMPANY_EMAIL=support@toyhourse.com
COMPANY_PHONE=+8801XXXXXXXXX
COMPANY_LOGO_URL=https://your-domain.com/logo/logo.png

# Telegram Bot Alerts (Optional)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# AI & LLM Integration (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_MODEL=google/gemini-2.5-flash

# Google OAuth & Google Sheets (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Mobile App Sync (Optional)
LATEST_APP_VERSION=1.0.0
MINIMUM_APP_VERSION=1.0.0
FORCE_APP_UPDATE=false
ANDROID_UPDATE_URL=
APP_UPDATE_MESSAGE="Please update your app to the latest version."
